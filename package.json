{
  "name": "id-app",
  "author": "Mikhailov Kirill <mikhailovkirill342@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikh-space/id-app.git"
  },
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @id-app/web run dev",
    "prepare": "husky",
    "build": "pnpm --filter @id-app/web run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "pnpm --filter @id-app/web run preview",
    "test": "pnpm --filter @id-app/web run test",
    "test:unit": "pnpm --filter @id-app/web run test:unit",
    "test:browser": "pnpm --filter @id-app/web run test:browser",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-jsx-attr-sort": "^1.0.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "lint-staged": {
    "{apps/web/{src,e2e},packages/*/src}/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "{apps/web/{src,e2e},packages/*/{src,styles}}/**/*.{css,scss,json,md}": [
      "prettier --write"
    ]
  }
}
